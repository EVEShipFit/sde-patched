namespace eve;

table DogmaAttributeText {
    id: int32 (key);
    tooltip_title: string;
    tooltip_description: string;
}

table Texts {
    build_number: int32;
    dogma_attributes: [DogmaAttributeText] (required);
    /// When CCP released this SDE build, in seconds since the Unix epoch.
    release_date: int64;
}

root_type Texts;
file_identifier "ESFT";
